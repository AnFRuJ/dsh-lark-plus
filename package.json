{
  "name": "dsh-lark-plus",
  "version": "0.1.0",
  "description": "DeepSeek Harness × Feishu/Lark bridge: chat, cards, approvals, task board, goals and schedules in Feishu — plus fully local (offline) voice transcription with a play bar in the Web GUI.",
  "type": "module",
  "license": "MIT",
  "author": "AnFRuJ",
  "homepage": "https://github.com/AnFRuJ/dsh-lark-plus#readme",
  "bugs": {
    "url": "https://github.com/AnFRuJ/dsh-lark-plus/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnFRuJ/dsh-lark-plus.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "bridge",
    "im",
    "chatbot",
    "voice",
    "speech-to-text",
    "asr",
    "sensevoice",
    "offline"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "axios": "^1.19.0",
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sherpa-onnx-node": "1.13.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev:link": "node scripts/dev-link.mjs",
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "prepack": "npm run build",
    "test:voice": "node --experimental-strip-types --test test/voice-smoke.test.ts test/voice-attachments.test.ts test/voice-handler-e2e.test.ts test/voice-routing.test.ts",
    "verify": "npm run check && npm run build && npm run test:voice"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
